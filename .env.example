MYSQL_DATABASE=police_force
MYSQL_USER=police_user
MYSQL_PASSWORD=police_password_change_me
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_PORT=3306

REDIS_PORT=6379
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
BACKEND_PORT=8081

JWT_SECRET=replace-with-at-least-32-random-characters
RESOURCE_CACHE_ENABLED=true

# 效能重算分片大小（分片数 = ceil(警局数 / 分片大小)）
EFFICIENCY_SHARD_SIZE=20
# 单批次最大分片数
EFFICIENCY_MAX_SHARDS=64
